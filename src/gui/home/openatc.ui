                </layout>
               </item>
               <item>
                <layout class="QHBoxLayout" name="session1MetaRow">
                 <property name="spacing"><number>12</number></property>
                 <item><widget class="QLabel" name="session1Flights"><property name="text"><string>✈ 42</string></property></widget></item>
                 <item><widget class="QLabel" name="session1Duration"><property name="text"><string>◷ 2h 15m</string></property></widget></item>
                 <item><spacer name="session1MetaSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                </layout>
               </item>
              </layout>
             </widget>
            </item>

            <!-- Recent Session 2 -->
