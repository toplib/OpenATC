<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>OpenATCMainWindow</class>
 <widget class="QMainWindow" name="OpenATCMainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1280</width>
    <height>800</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>OpenATC - Operations Center</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* ===== Global ===== */
QMainWindow, QWidget#centralWidget {
    background-color: #131313;
    color: #e4e2e1;
    font-family: "Inter", sans-serif;
    font-size: 11px;
}

QLabel { background: transparent; border: none; }

/* ===== Top Header Bar ===== */
QFrame#headerBar {
    background-color: #1f2020;
    border: none;
    border-bottom: 1px solid #3b4b37;
}

QLabel#logoLabel {
    font-size: 14px;
    font-weight: 900;
    letter-spacing: -1px;
    color: #00e639;
    padding-left: 6px;
}

/* Tab-style nav buttons in header */
QPushButton#navButtonActive {
    background-color: transparent;
    color: #00e639;
    border: none;
    border-bottom: 2px solid #00e639;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    min-height: 24px;
}

QPushButton#navPilotMode,
QPushButton#navModelHub,
QPushButton#navSettings {
    background-color: transparent;
    color: #b9ccb2;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 11px;
    font-weight: 400;
    padding: 4px 10px;
    min-height: 24px;
}

QPushButton#navPilotMode:hover,
QPushButton#navModelHub:hover,
QPushButton#navSettings:hover {
    background-color: #353535;
    color: #e4e2e1;
}

/* Search bar */
QLineEdit#searchBar {
    background-color: #2a2a2a;
    border: 1px solid #3b4b37;
    border-radius: 2px;
    color: #e4e2e1;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 6px;
    min-height: 20px;
    max-height: 20px;
    min-width: 220px;
}

QLineEdit#searchBar:focus { border-color: #00e639; }

/* Header icon buttons */
QPushButton#headerSettingsButton,
QPushButton#headerTerminalButton,
QPushButton#headerHelpButton {
    background-color: transparent;
    border: none;
    border-radius: 2px;
    color: #b9ccb2;
    font-size: 13px;
}

QPushButton#headerSettingsButton:hover,
QPushButton#headerTerminalButton:hover,
QPushButton#headerHelpButton:hover {
    background-color: #353535;
    color: #e4e2e1;
}

/* Avatar */
QFrame#avatarFrame {
    background-color: #353535;
    border: 1px solid #3b4b37;
    border-radius: 10px;
}

/* ===== Sidebar ===== */
QFrame#sidebarFrame {
    background-color: #1b1c1c;
    border: none;
    border-right: 1px solid #3b4b37;
}

QFrame#sidebarHeader {
    background-color: #353535;
    border: none;
    border-bottom: 1px solid #3b4b37;
}

QLabel#projectsLabel, QLabel#recentSessionsLabel {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #b9ccb2;
    padding: 0px 4px;
}

QPushButton#newProjectButton, QPushButton#openProjectButton {
    background-color: #353535;
    border: 1px solid #3b4b37;
    border-radius: 2px;
    color: #e4e2e1;
    font-size: 11px;
    min-height: 24px;
    padding: 0px 8px;
}

QPushButton#newProjectButton:hover, QPushButton#openProjectButton:hover {
    background-color: #393939;
}

/* Recent session items */
QFrame#recentSession1 {
    background-color: #2a2a2a;
    border: 1px solid rgba(0,230,57,0.4);
    border-radius: 2px;
}
QFrame#recentSession2, QFrame#recentSession3 {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
}
QFrame#recentSession2:hover, QFrame#recentSession3:hover {
    background-color: #2a2a2a;
}

QLabel#session1Title {
    font-size: 12px; font-weight: 600; color: #00e639;
}
QLabel#session2Title, QLabel#session3Title {
    font-size: 12px; font-weight: 600; color: #e4e2e1;
}
QLabel#session1Time, QLabel#session2Time, QLabel#session3Time,
QLabel#session1Flights, QLabel#session2Flights, QLabel#session3Flights,
QLabel#session1Duration, QLabel#session2Duration, QLabel#session3Duration {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 500;
    color: #b9ccb2;
}

/* ===== Main Canvas ===== */
QScrollArea#mainCanvas { background-color: #131313; border: none; }
QWidget#canvasContent { background-color: #131313; }

QLabel#welcomeTitle {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: #e4e2e1;
}
QLabel#welcomeSubtitle {
    font-size: 12px;
    font-weight: 400;
    color: #b9ccb2;
}

/* Primary action card (New Simulation) */
QFrame#cardNewSimulation {
    background-color: #2a2a2a;
    border: 1px solid #3b4b37;
    border-radius: 4px;
}
QFrame#cardNewSimulation:hover { border-color: #00e639; }

/* Secondary cards */
QFrame#cardTraining, QFrame#cardHistorical {
    background-color: #1b1c1c;
    border: 1px solid #3b4b37;
    border-radius: 4px;
}
QFrame#cardTraining:hover, QFrame#cardHistorical:hover {
    background-color: #2a2a2a;
}

/* Tertiary cards */
QFrame#cardReplay, QFrame#cardPlugins, QFrame#cardModels, QFrame#cardSystemSettings {
    background-color: #1b1c1c;
    border: 1px solid #3b4b37;
    border-radius: 4px;
}
QFrame#cardReplay:hover, QFrame#cardPlugins:hover,
QFrame#cardModels:hover, QFrame#cardSystemSettings:hover {
    background-color: #2a2a2a;
}

/* Card icon frames (tertiary) */
QFrame#replayIconFrame, QFrame#pluginsIconFrame,
QFrame#modelsIconFrame, QFrame#settingsIconFrame {
    background-color: #353535;
    border: none;
    border-radius: 2px;
}

/* Card titles &amp; descriptions */
QLabel#newSimTitle,QLabel#trainingTitle,QLabel#historicalTitle,QLabel#replayTitle,QLabel#pluginsTitle,QLabel#modelsTitle,QLabel#systemSettingsTitle {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: #e4e2e1;
}
QLabel#newSimDesc, QLabel#trainingDesc, QLabel#historicalDesc,
QLabel#replayDesc, QLabel#pluginsDesc, QLabel#modelsDesc, QLabel#systemSettingsDesc {
    font-size: 12px;
    font-weight: 400;
    color: #b9ccb2;
}

/* Card icons */
QLabel#newSimIcon { font-size: 28px; color: #00e639; }
QLabel#trainingIcon, QLabel#historicalIcon { font-size: 24px; color: #ffba43; }
QLabel#replayIcon, QLabel#pluginsIcon, QLabel#modelsIcon, QLabel#settingsIcon {
    font-size: 16px; color: #b9ccb2;
}

/* ===== Footer Bar ===== */
QFrame#footerBar {
    background-color: #0e0e0e;
    border: none;
    border-top: 1px solid #3b4b37;
}

QLabel#footerLogo {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #e4e2e1;
}
QLabel#footerStatus {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 500;
    color: #ffba43;
}

QPushButton#footerResources, QPushButton#footerNetworkStatus {
    background-color: transparent;
    border: none;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 500;
    color: #b9ccb2;
    padding: 0px 4px;
}
QPushButton#footerResources:hover, QPushButton#footerNetworkStatus:hover {
    color: #00e639;
}
   </string>
  </property>
  <widget class="QWidget" name="centralWidget">
   <layout class="QVBoxLayout" name="mainVerticalLayout">
    <property name="spacing"><number>0</number></property>
    <property name="leftMargin"><number>0</number></property>
    <property name="topMargin"><number>0</number></property>
    <property name="rightMargin"><number>0</number></property>
