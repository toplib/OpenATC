      </widget>

      <!-- ===== MAIN CANVAS ===== -->
      <widget class="QScrollArea" name="mainCanvas">
       <property name="widgetResizable"><bool>true</bool></property>
       <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
       <property name="styleSheet">
        <string notr="true">
QScrollArea#mainCanvas { background-color: #131313; border: none; }
QWidget#canvasContent { background-color: #131313; }
QScrollBar:vertical { background-color: #131313; width: 8px; }
QScrollBar::handle:vertical { background-color: #3b4b37; border-radius: 4px; min-height: 20px; }
QScrollBar::handle:vertical:hover { background-color: #84967e; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
        </string>
       </property>
       <widget class="QWidget" name="canvasContent">
        <layout class="QVBoxLayout" name="canvasMainLayout">
         <property name="spacing"><number>0</number></property>
         <property name="leftMargin"><number>32</number></property>
         <property name="topMargin"><number>32</number></property>
         <property name="rightMargin"><number>32</number></property>
         <property name="bottomMargin"><number>32</number></property>

         <!-- Welcome Header -->
         <item>
          <widget class="QLabel" name="welcomeTitle">
           <property name="text"><string>Welcome to OpenATC</string></property>
          </widget>
         </item>
         <item>
